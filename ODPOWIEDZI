Zadanie 3: Sprawdź, czy plik jest tym, za co się podaje

SYGNATURY = {".png": b"\x89PNG", ".jpg": b"\xff\xd8\xff", ".pdf": b"%PDF"}

def czy_prawdziwy_typ(dane, rozszerzenie):
    sygnatura = SYGNATURY.get(rozszerzenie.lower())
    return sygnatura is not None and dane.startswith(sygnatura)
