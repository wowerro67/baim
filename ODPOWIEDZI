Zadanie 2: Losowa nazwa pliku

import uuid

def losowa_nazwa(rozszerzenie):
    # Oryginalna nazwa moze zawierac "../" (path traversal), podwojne
    # rozszerzenie (foto.php.jpg) albo nadpisac istniejacy plik.
    return uuid.uuid4().hex + rozszerzenie.lower()

